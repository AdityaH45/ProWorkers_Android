<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Admin app only: "auto-verify UPI payments" reads "money received" notifications of UPI apps.
             Only active after the admin turns on Notification access in Android settings. -->
        <service
            android:name=".UpiNotificationListener"
            android:label="ProWorkers UPI auto-verify"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
